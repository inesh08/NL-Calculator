{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nl-calculator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "observability": { "enabled": true },

  // Not secret. Secrets (SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET, OPENAI_API_KEY,
  // DATABASE_URL, ZOROVAL_INGEST_KEY) are set with `wrangler secret put`.
  // ZOROVAL_CAPTURE_CONTENT is deliberately not set: unset = the SDK default (question
  // and answer text IS sent to Zoroval). Add "ZOROVAL_CAPTURE_CONTENT": "false" below to
  // stop sending text. Changing a var restarts the container within a minute.
  // ZOROVAL_INGEST_KEY and ZOROVAL_INGEST_URL are one pair. A key made on
  // app-preview.zoroval.com needs the preview ingest (as here). A key made on app.zoroval.com
  // needs this line removed (SDK default ingest). A mismatch: the ingest rejects the key, the
  // SDK logs once and stops sending traces for that process, and the bot keeps replying.
  // ZOROVAL_ENVIRONMENT is only a label on the traces (which deployment sent them); it does
  // not choose which Zoroval environment receives them. That is the ingest URL's job.
  "vars": {
    "LOG_LEVEL": "INFO",
    "ZOROVAL_ENVIRONMENT": "cloudflare",
    "ZOROVAL_INGEST_URL": "https://ingest-preview.zoroval.com"
  },

  // Keeps the container warm for the 2-minute monitor.
  "triggers": { "crons": ["* * * * *"] },

  "containers": [
    {
      "class_name": "NlCalculatorContainer",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NL_CALCULATOR", "class_name": "NlCalculatorContainer" }]
  },
  "exports": {
    "NlCalculatorContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
